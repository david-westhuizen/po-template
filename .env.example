# Copy to `.env` and fill with your OWN Supabase project values.
# Vite only exposes vars prefixed with VITE_ to the client.
#
# The anon/publishable key is named VITE_SUPABASE_PUBLISHABLE_KEY (raimonland
# convention). PROJECT_ID is only used by the Supabase CLI.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref
